    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#35354D" />
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#40405C" />

    <SolidColorBrush x:Key="ListItemHoverBrush" Color="#252538" />
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="#2F2B4A" />
    <SolidColorBrush x:Key="ListItemSelectedBorderBrush" Color="#7C6CF0" />

    <SolidColorBrush x:Key="DropHighlightBrush" Color="#3D3568" />
    <SolidColorBrush x:Key="ScrollbarThumbBrush" Color="#4A4A62" />

    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#1C1C2B" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#3A3A52" />

</ResourceDictionary>
