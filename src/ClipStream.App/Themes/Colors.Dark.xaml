<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#14141F" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1C1C2B" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#252538" />
    <SolidColorBrush x:Key="BorderBrush" Color="#3A3A52" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#2A2A3E" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EDEEF5" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9496AB" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#6B6D82" />

    <SolidColorBrush x:Key="AccentBrush" Color="#7C6CF0" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#9488F5" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#6558D9" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#2A2548" />

    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#EDEEF5" />
