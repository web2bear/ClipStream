<Window x:Class="ClipStream.App.MainWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        xmlns:behaviors="clr-namespace:ClipStream.App.Behaviors"

        xmlns:converters="clr-namespace:ClipStream.App.Converters"

        Title="ClipStream"

        Height="680"

        Width="1000"

        MinHeight="420"

        MinWidth="760"

        Background="{DynamicResource WindowBackgroundBrush}"

        Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="16">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto" />

            <RowDefinition Height="*" />

        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="240" />

            <ColumnDefinition Width="*" />

        </Grid.ColumnDefinitions>



        <Border Grid.Row="0" Grid.ColumnSpan="2"

                Style="{StaticResource PanelBorderStyle}"

                Padding="14,12"

                Margin="0,0,0,12">

            <Grid>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <Border Background="{DynamicResource AccentSubtleBrush}"

                            CornerRadius="8"

                            Width="36" Height="36"

                            Margin="0,0,12,0">

                        <TextBlock Text="&#xE8C8;"

                                   FontFamily="Segoe MDL2 Assets"

                                   FontSize="18"

                                   Foreground="{DynamicResource AccentBrush}"

                                   HorizontalAlignment="Center"

                                   VerticalAlignment="Center" />

                    </Border>

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="ClipStream"

                                   FontSize="18"

                                   FontWeight="SemiBold"

                                   Foreground="{DynamicResource TextPrimaryBrush}" />

                        <TextBlock Text="Clipboard vault"

                                   FontSize="11"

                                   Foreground="{DynamicResource TextSecondaryBrush}"

                                   Margin="0,2,0,0" />

                    </StackPanel>

                </StackPanel>



                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                    <Button Content="Export vault"

                            Style="{StaticResource SecondaryButtonStyle}"

                            Margin="0,0,8,0"

                            Command="{Binding ExportAllCommand}" />

                    <Button Style="{StaticResource IconButtonStyle}"

                            Command="{Binding ToggleThemeCommand}"

                            ToolTip="Переключить тему">

                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center">

                            <TextBlock.Style>

                                <Style TargetType="TextBlock">

                                    <Setter Property="Text" Value="&#xE706;" />

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding IsDarkTheme}" Value="False">

                                            <Setter Property="Text" Value="&#xE708;" />

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </TextBlock.Style>

                        </TextBlock>

                    </Button>

                </StackPanel>

            </Grid>

        </Border>



        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource PanelBorderStyle}">

            <DockPanel>

                <TextBlock DockPanel.Dock="Top" Text="Streams" Style="{StaticResource PanelHeaderStyle}" />

                <Button DockPanel.Dock="Top"

                        Content="Add stream"

                        Style="{StaticResource SecondaryButtonStyle}"

                        Margin="0,0,0,10"

                        Command="{Binding AddStreamCommand}" />

                <ListBox ItemsSource="{Binding Streams}"

                         SelectedItem="{Binding SelectedStream}"

                         Style="{StaticResource ModernListBoxStyle}">

                    <ListBox.Resources>

                        <converters:StreamIconConverter x:Key="StreamIconConverter" />

                    </ListBox.Resources>

                    <ListBox.ItemContainerStyle>

                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource ModernListBoxItemStyle}">

                            <Setter Property="behaviors:StreamDropBehavior.IsEnabled" Value="True" />

                        </Style>

                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>

                        <DataTemplate>

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="{Binding Icon, Converter={StaticResource StreamIconConverter}}"

                                           FontFamily="Segoe MDL2 Assets"

                                           FontSize="15"

                                           VerticalAlignment="Center"

                                           Margin="0,0,10,0"

                                           Foreground="{DynamicResource AccentBrush}" />

                                <TextBlock Text="{Binding Name}"

                                           VerticalAlignment="Center"

                                           Foreground="{DynamicResource TextPrimaryBrush}" />

                            </StackPanel>

                        </DataTemplate>

                    </ListBox.ItemTemplate>

                    <ListBox.ContextMenu>

                        <ContextMenu>

                            <MenuItem Header="Edit stream..."

                                      Command="{Binding DataContext.EditStreamCommand, RelativeSource={RelativeSource AncestorType=Window}}"

                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

                            <MenuItem Header="Export to Obsidian..."

                                      Command="{Binding DataContext.ExportStreamCommand, RelativeSource={RelativeSource AncestorType=Window}}"

                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

                        </ContextMenu>

                    </ListBox.ContextMenu>

                </ListBox>

            </DockPanel>

        </Border>



        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource PanelBorderStyle}" Margin="12,0,0,0">

            <DockPanel>

                <TextBlock DockPanel.Dock="Top" Text="Fragments" Style="{StaticResource PanelHeaderStyle}" />

                <ListBox ItemsSource="{Binding Fragments}"

                         SelectedItem="{Binding SelectedFragment}"

                         Style="{StaticResource ModernListBoxStyle}"

                         MouseDoubleClick="FragmentsList_OnMouseDoubleClick">

                    <ListBox.ItemContainerStyle>

                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource ModernListBoxItemStyle}">

                            <Setter Property="Padding" Value="2" />

                            <Setter Property="Margin" Value="0" />

                        </Style>

                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>

                        <DataTemplate>

                            <Border Style="{StaticResource FragmentCardStyle}"

                                    behaviors:FragmentDragBehavior.IsEnabled="True"

                                    behaviors:FragmentDragBehavior.Fragment="{Binding}">

                                <StackPanel>

                                    <TextBlock Text="{Binding PreviewText}"

                                               TextWrapping="Wrap"

                                               MaxHeight="80"

                                               Foreground="{DynamicResource TextPrimaryBrush}"

                                               LineHeight="18" />

                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">

                                        <Border Background="{DynamicResource AccentSubtleBrush}"

                                                CornerRadius="4"

                                                Padding="6,2"

                                                Margin="0,0,8,0">

                                            <TextBlock Text="{Binding Kind}"

                                                       FontSize="11"

                                                       Foreground="{DynamicResource AccentBrush}" />

                                        </Border>

                                        <TextBlock Text="{Binding CapturedAt}"

                                                   FontSize="11"

                                                   Foreground="{DynamicResource TextSecondaryBrush}"

                                                   VerticalAlignment="Center" />

                                    </StackPanel>

                                </StackPanel>

                            </Border>

                        </DataTemplate>

                    </ListBox.ItemTemplate>

                    <ListBox.ContextMenu>

                        <ContextMenu>

                            <MenuItem Header="Paste to active window"

                                      Command="{Binding DataContext.PasteFragmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"

                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

                            <MenuItem Header="Export to Obsidian..."

                                      Command="{Binding DataContext.ExportFragmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"

                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />

                        </ContextMenu>

                    </ListBox.ContextMenu>

                </ListBox>

            </DockPanel>

        </Border>

    </Grid>

</Window>

