<Window x:Class="ClipStream.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:ClipStream.App.Behaviors"
        xmlns:converters="clr-namespace:ClipStream.App.Converters"
        Title="ClipStream"
        Height="720"
        Width="1100"
        MinHeight="420"
        MinWidth="800"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}">

    <Window.Resources>
        <converters:StreamIconConverter x:Key="StreamIconConverter" />
        <converters:ByteSizeConverter x:Key="ByteSizeConverter" />
        <converters:FragmentKindDisplayConverter x:Key="FragmentKindDisplayConverter" />
        <converters:FragmentKindGlyphConverter x:Key="FragmentKindGlyphConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Command bar -->
        <Border Grid.Row="0"
                Background="{DynamicResource CommandBarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,6">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8B7;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="{DynamicResource FolderIconBrush}"
                               VerticalAlignment="Center"
                               Margin="4,0,8,0" />
                    <TextBlock Text="ClipStream"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Border Width="1"
                            Height="18"
                            Background="{DynamicResource BorderBrush}"
                            Margin="12,0" />
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding AddStreamCommand}"
                            ToolTip="Добавить поток">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <TextBlock Text="Новый поток" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButtonStyle}"
                            Command="{Binding ToggleDetailsPaneCommand}"
                            ToolTip="Показать или скрыть панель сведений"
                            Margin="0,0,4,0">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE8A9;" />
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDetailsPaneVisible}" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}"
                            Command="{Binding ToggleThemeCommand}"
                            ToolTip="Переключить тему">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE706;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkTheme}" Value="False">
                                            <Setter Property="Text" Value="&#xE708;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="160" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- Navigation pane -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Потоки"
                               Style="{StaticResource PanelHeaderStyle}" />

                    <ListBox ItemsSource="{Binding Streams}"
                             SelectedItem="{Binding SelectedStream}"
                             Style="{StaticResource ModernListBoxStyle}"
                             Margin="0,0,0,8">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavListBoxItemStyle}">
                                <Setter Property="behaviors:StreamDropBehavior.IsEnabled" Value="True" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Icon, Converter={StaticResource StreamIconConverter}}"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="15"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"
                                               Foreground="{DynamicResource FolderIconBrush}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Name}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <ContextMenu Opened="StreamContextMenu_OnOpened"
                                         ItemsSource="{Binding PlacementTarget.DataContext.StreamContextMenuItems, RelativeSource={RelativeSource Self}}"
                                         ItemContainerStyle="{StaticResource ActionContextMenuItemStyle}" />
                        </ListBox.ContextMenu>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource BorderSubtleBrush}"
                          ResizeBehavior="PreviousAndNext" />

            <!-- Details view + preview pane -->
            <Border Grid.Column="2" Background="{DynamicResource ContentBackgroundBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="120" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="{Binding DetailsPaneRowHeight}" MinHeight="0" />
                    </Grid.RowDefinitions>

                    <ListView Grid.Row="0"
                              ItemsSource="{Binding Fragments}"
                              SelectedItem="{Binding SelectedFragment}"
                              Style="{StaticResource ExplorerListViewStyle}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource ExplorerListViewItemStyle}">
                                <Setter Property="behaviors:FragmentDragBehavior.IsEnabled" Value="True" />
                                <Setter Property="behaviors:FragmentDragBehavior.Fragment" Value="{Binding}" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView AllowsColumnReorder="True">
                                <GridViewColumn Header="Имя" Width="340">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="8,0,8,0">
                                                <TextBlock Text="{Binding Kind, Converter={StaticResource FragmentKindGlyphConverter}}"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="15"
                                                           Width="22"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                                <TextBlock Text="{Binding Title}"
                                                           Style="{StaticResource TitleDisplayTextBlockStyle}"
                                                           MaxWidth="280"
                                                           Margin="0,0,8,0"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Дата изменения" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CapturedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                                       Margin="12,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Тип" Width="200">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Kind, Converter={StaticResource FragmentKindDisplayConverter}}"
                                                       Margin="12,0"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Размер" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Payloads, Converter={StaticResource ByteSizeConverter}}"
                                                       Margin="12,0"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                        <ListView.ContextMenu>
                            <ContextMenu Opened="FragmentContextMenu_OnOpened"
                                         ItemsSource="{Binding PlacementTarget.DataContext.FragmentContextMenuItems, RelativeSource={RelativeSource Self}}"
                                         ItemContainerStyle="{StaticResource ActionContextMenuItemStyle}" />
                        </ListView.ContextMenu>
                    </ListView>

                    <GridSplitter Grid.Row="1"
                                  Height="4"
                                  HorizontalAlignment="Stretch"
                                  Background="{DynamicResource BorderSubtleBrush}"
                                  ResizeBehavior="PreviousAndNext"
                                  ResizeDirection="Rows">
                        <GridSplitter.Style>
                            <Style TargetType="GridSplitter">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDetailsPaneVisible}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </GridSplitter.Style>
                    </GridSplitter>

                    <Border Grid.Row="2"
                            Background="{DynamicResource SidebarBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            MinHeight="0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDetailsPaneVisible}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid Margin="12">
                            <TextBlock Text="Выберите фрагмент, чтобы увидеть превью и сведения"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedFragment}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedFragment}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" MinWidth="180" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" MinWidth="200" />
                                </Grid.ColumnDefinitions>

                                <!-- Preview -->
                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0"
                                          DataContext="{Binding SelectedFragment}"
                                          Margin="0,0,0,8"
                                          MinHeight="28">
                                        <TextBlock Text="{Binding Title}"
                                                   Style="{StaticResource PreviewTitleDisplayTextBlockStyle}"
                                                   ToolTip="Двойной щелчок — изменить имя"
                                                   MouseLeftButtonDown="TitleDisplay_OnMouseLeftButtonDown" />
                                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource PreviewTitleEditTextBoxStyle}"
                                                 Visibility="Collapsed"
                                                 KeyDown="TitleTextBox_KeyDown"
                                                 LostFocus="TitleTextBox_LostFocus" />
                                    </Grid>

                                    <Border Grid.Row="1"
                                            Background="{DynamicResource ContentBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="8">
                                        <Grid>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <ScrollViewer.Style>
                                                    <Style TargetType="ScrollViewer">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasPreviewImage}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ScrollViewer.Style>
                                                <TextBox Text="{Binding PreviewText, Mode=OneWay}"
                                                         Style="{StaticResource PreviewTextBoxStyle}" />
                                            </ScrollViewer>

                                            <Border Background="Transparent"
                                                    BorderThickness="1"
                                                    BorderBrush="Transparent"
                                                    Focusable="True"
                                                    FocusVisualStyle="{x:Null}"
                                                    MouseLeftButtonDown="PreviewImage_OnMouseLeftButtonDown"
                                                    KeyDown="PreviewImage_OnKeyDown"
                                                    ToolTip="Ctrl+C — копировать изображение">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasPreviewImage}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Image Source="{Binding PreviewImage}"
                                                       Stretch="Uniform"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                            </Border>

                                            <TextBlock Text="Нет превью"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextMutedBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding HasPreviewImage}" Value="False" />
                                                                    <Condition Binding="{Binding PreviewText}" Value="" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- Commands + Details -->
                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0"
                                                Orientation="Horizontal"
                                                Margin="0,0,0,10">
                                        <Button Command="{Binding OpenInTextEditorCommand}"
                                                ToolTip="Открыть в текстовом редакторе"
                                                Padding="6"
                                                MinWidth="28"
                                                MinHeight="28"
                                                Margin="0,0,4,0">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTextEditorAvailable}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="&#xE8A5;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="14"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Button>

                                        <Button Command="{Binding OpenInImageViewerCommand}"
                                                ToolTip="Открыть изображение"
                                                Padding="6"
                                                MinWidth="28"
                                                MinHeight="28">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasPreviewImage}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="&#xE91B;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="14"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Button>
                                    </StackPanel>

                                    <ScrollViewer Grid.Row="1"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel>
                                            <TextBlock Text="Сведения"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="0,0,0,10" />

                                            <TextBlock Text="Тип"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding SelectedFragmentKindText}"
                                                       Margin="0,2,0,10"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />

                                            <TextBlock Text="Дата"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding SelectedFragment.CapturedAt, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}"
                                                       Margin="0,2,0,10"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />

                                            <TextBlock Text="Размер"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding SelectedFragmentSizeText}"
                                                       Margin="0,2,0,10"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />

                                            <TextBlock Text="Источник"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBlock Margin="0,2,0,10"
                                                       Foreground="{DynamicResource TextPrimaryBrush}">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} (PID {1})">
                                                        <Binding Path="SelectedFragment.SourceProcessName" TargetNullValue="—" />
                                                        <Binding Path="SelectedFragment.SourceProcessId" TargetNullValue="—" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>

                                            <TextBlock Text="Форматы"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding SelectedFragmentFormatsText}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Style="{StaticResource StatusBarStyle}">
            <Grid>
                <TextBlock Text="{Binding StatusText}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButtonStyle}"
                            Command="{Binding ToggleDetailsPaneCommand}"
                            ToolTip="Панель сведений"
                            Padding="6"
                            MinWidth="28"
                            MinHeight="28">
                        <TextBlock Text="&#xE8A9;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDetailsPaneVisible}" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
